{
  "name": "sveltekit-boilerplate",
  "type": "module",
  "private": true,
  "description": "SvelteKit 2 SaaS boilerplate with Svelte 5, TypeScript and Tailwind CSS 4: GitHub OAuth + magic links, admin RBAC, Drizzle + Postgres, Polar billing, i18n and the @uipkge shadcn-svelte UI registry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uday-a/sveltekit-boilerplate.git"
  },
  "homepage": "https://uipkge.dev",
  "keywords": [
    "sveltekit",
    "svelte",
    "saas-boilerplate",
    "sveltekit-boilerplate",
    "saas-starter-kit",
    "svelte5",
    "typescript",
    "tailwindcss",
    "shadcn-svelte",
    "drizzle-orm",
    "postgresql",
    "boilerplate",
    "starter-kit",
    "authentication",
    "rbac",
    "admin-dashboard",
    "polar",
    "i18n",
    "bits-ui",
    "uipkge"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@axiomhq/js": "^2.0.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.48.0",
    "@polar-sh/sdk": "^1.0.0",
    "@sentry/sveltekit": "^11.1.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@tanstack/svelte-form": "^1.33.5",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "arctic": "^3.7.0",
    "bits-ui": "^2.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "echarts": "^6.1.0",
    "iron-session": "^9.0.1",
    "leaflet": "^1.9.4",
    "postgres": "^3.4.9",
    "posthog-js": "^1.434.17",
    "resend": "^6.30.0",
    "svelte": "^5.57.1",
    "svelte-i18n": "^4.0.1",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^25.8.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.10"
  }
}
